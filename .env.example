# HerHealth AI Environment Configuration
PORT=5000
NODE_ENV=development

# Database connection
MONGODB_URI=mongodb://127.0.0.1:27017/herhealth_db

# Session secret for secure cookie sessions
SESSION_SECRET=herhealth_dev_secret_key_change_in_production_987654321

# Emergency contact shown in Level 4 questionnaire guidance (default: India 112)
EMERGENCY_NUMBER=112

# Frontend URL (for CORS when run separately)
FRONTEND_URL=http://localhost:5000

# AI Provider Configuration (Optional - runs in honest educational demo mode if left empty)
AI_PROVIDER=generic
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
